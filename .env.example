# Environment Configuration Example
NODE_ENV=development

# JWT Secret Key (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Captcha HMAC Secret
CAPTCHA_SECRET=your_captcha_hmac_secret_here

# Salt for Hashing IP Addresses
IP_SALT=your_ip_salt_secret_here

# Admin Credentials
ADMIN_USERNAME=admin
# Default Admin Password Hash (bcrypt cost-12)
# Default Password: Admin@Kajian2024!
# In Next.js .env, dollar signs must be escaped as \$ to prevent variable expansion
ADMIN_PASSWORD_HASH=\$2a\$12\$nXxmJWdbP1VW6vC/hhjAJO.HFf0n.fSvgrUPLohfOq1hiBP4T5VEy

ALLOWED_ORIGIN=http://localhost:3000
